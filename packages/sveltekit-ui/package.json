{
  "name": "@repo/sveltekit-ui",
  "version": "0.0.0",
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-kit sync && svelte-package --watch --input=src",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-kit sync && svelte-package --input=src",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.36.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-svelte-csf": "^5.0.7",
    "@storybook/addon-vitest": "^9.1.0",
    "@storybook/sveltekit": "^9.1.0",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.17.0",
    "@vitest/browser": "^3.2.4",
    "daisyui": "^5.0.50",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^9.1.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^9.1.0",
    "svelte": "^5.37.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^0.1.0"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@lucide/svelte": "^0.488.0",
    "better-auth": "^1.3.4",
    "formsnap": "^2.0.1",
    "nodemailer": "^7.0.5",
    "sveltekit-superforms": "^2.27.1",
    "zod": "^3.25.76",
    "@repo/library": "workspace:*"
  }
}
